<%- include('partials/header', { usuario: usuario }) %>

<div class="card card-narrow">
  <h1>Iniciar sesión</h1>
  <p class="muted">Ingresa con tu número de empleado y contraseña.</p>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="/login" method="POST">
    <label for="numeroEmpleado">Número de empleado</label>
    <input type="text" id="numeroEmpleado" name="numeroEmpleado"
           value="<%= numeroEmpleado %>" autofocus required />

    <label for="password">Contraseña</label>
    <input type="password" id="password" name="password" required />

    <button type="submit" class="btn btn-primary btn-block">Entrar</button>
  </form>
</div>

<%- include('partials/footer') %>
