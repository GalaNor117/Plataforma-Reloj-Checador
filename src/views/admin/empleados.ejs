<%- include('../partials/header', { usuario: usuario }) %>

<div class="card">
  <h1>Empleados</h1>

  <% if (mensaje) { %>
    <div class="alert alert-success"><%= mensaje.texto %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <h2>Dar de alta empleado</h2>
  <form action="/admin/empleados" method="POST" class="form-grid">
    <div>
      <label for="numeroEmpleado">Número de empleado</label>
      <input type="text" id="numeroEmpleado" name="numeroEmpleado" required />
    </div>
    <div>
      <label for="nombre">Nombre completo</label>
      <input type="text" id="nombre" name="nombre" required />
    </div>
    <div>
      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" required />
    </div>
    <div>
      <label for="rol">Rol</label>
      <select id="rol" name="rol">
        <option value="empleado">Empleado</option>
        <option value="admin">Administrador</option>
      </select>
    </div>
    <div class="form-grid-action">
      <button type="submit" class="btn btn-primary">Agregar</button>
    </div>
  </form>

  <h2>Listado</h2>
  <table class="tabla">
    <thead>
      <tr><th>No.</th><th>Nombre</th><th>Rol</th><th>Activo</th><th>Alta</th></tr>
    </thead>
    <tbody>
      <% empleados.forEach(function (e) { %>
        <tr>
          <td><%= e.numero_empleado %></td>
          <td><%= e.nombre %></td>
          <td><span class="badge"><%= e.rol %></span></td>
          <td><%= e.activo ? 'Sí' : 'No' %></td>
          <td><%= new Date(e.created_at).toLocaleDateString('es-MX') %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
