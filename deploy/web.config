<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reverse proxy de IIS hacia la app Node (Windows Server 2016).

  Coloca este archivo en la raíz del sitio de IIS que apunta a tu app.
  Requisitos (instalar una sola vez en el servidor):
    - URL Rewrite        https://www.iis.net/downloads/microsoft/url-rewrite
    - Application Request Routing (ARR)  https://www.iis.net/downloads/microsoft/application-request-routing
    - En ARR: Server Farms / "Application Request Routing Cache" -> Server Proxy Settings -> Enable proxy = ON

  IIS recibe el tráfico en 80/443 (con el certificado SSL) y lo reenvía a
  http://localhost:3000 (la app Node, que corre como servicio de Windows).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <!--
        Permite fijar la cabecera X-Forwarded-Proto para que Express sepa
        que el cliente llegó por HTTPS (necesario para las cookies seguras).
        Si IIS bloquea esta sección, ejecuta una sola vez como admin:
          %windir%\system32\inetsrv\appcmd.exe unlock config -section:system.webServer/rewrite/allowedServerVariables
      -->
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
      </allowedServerVariables>

      <rules>
        <!-- Redirige todo el tráfico HTTP a HTTPS -->
        <rule name="HTTP a HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Reenvía todo lo demás a la app Node en el puerto 3000 -->
        <rule name="ReverseProxyANode" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- No dejes que IIS sirva archivos estáticos por su cuenta: que todo pase por Node -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
