# Copia este archivo a .env y ajusta los valores

# Entorno: 'development' o 'production'
NODE_ENV=production

# Puerto interno donde escucha Node (IIS hará el proxy del 80/443 hacia aquí)
PORT=3000

# --- Despliegue detrás de IIS (Windows Server 2016) ---
# Confía en el reverse proxy local de IIS para detectar HTTPS.
TRUST_PROXY=1
# Marca las cookies de sesión como seguras (solo HTTPS). Actívalo en producción.
COOKIE_SECURE=true

# Conexión a PostgreSQL
# Opción A: cadena de conexión completa
DATABASE_URL=postgres://usuario:password@localhost:5432/reloj_checador

# Opción B: variables sueltas (se usan si no defines DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=reloj_checador

# Secreto para firmar las cookies de sesión (cámbialo por algo aleatorio y largo)
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Zona horaria usada para agrupar los registros por día en los reportes
TZ=America/Mexico_City

# Datos del administrador inicial (usados por: npm run db:seed)
ADMIN_NUMERO=admin
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=admin123
